# Copy from Vercel Neon integration (prefer `vercel env pull .env.local`).
# Never commit real values. Rotate any DB password that was pasted into chat.

# Neon (Vercel integration injects these)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Managed Better Auth (Console → Project → Auth → Configuration)
# Same value for browser + server; JWKS can be derived as ${NEON_AUTH_BASE_URL}/.well-known/jwks.json
VITE_NEON_AUTH_URL=
NEON_AUTH_BASE_URL=
# Optional override (defaults to ${NEON_AUTH_BASE_URL}/.well-known/jwks.json)
# NEON_AUTH_JWKS_URL=

# Optional alias used by older Lovable migration tooling
# LOVABLE_DB_MIGRATION_URL=

# Ask AI: configure one server-only provider key; never use a VITE_ prefix.
# LOVABLE_API_KEY=
# OPENAI_API_KEY=

# --- Discovery monitor / Vercel Cron (see docs/ISI_DISCOVERY_CRON.md) ---
# CRON_SECRET=                 # required for /api/cron/discovery-monitor (fail closed if unset)
# DISCOVERY_MONITOR_ACTOR=cron:discovery-monitor
# DISCOVERY_LIVE_PUBMED=0      # set 1 only with NCBI_API_KEY / PUBMED_API_KEY
# DISCOVERY_LIVE_CTGOV=0
# DISCOVERY_LIVE_EUROPE_PMC=0  # retrieval pilots; not default monitor adapters
# NCBI_API_KEY=
# PUBMED_API_KEY=

# --- Email alerts (deferred until fully configured; never pretend sent) ---
# DISCOVERY_EMAIL_ALERTS=0
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_ALERT_TO=              # optional ops override for cron email attempts

# --- Stripe Researcher Pro (scaffolding; inactive without price IDs — docs/ISI_STRIPE_BILLING_RUNBOOK.md) ---
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# VITE_STRIPE_PUBLISHABLE_KEY=
# STRIPE_PRICE_RESEARCHER_PRO= # real Dashboard price id only — never invent
# STRIPE_PRICE_TEAM=
# STRIPE_CHECKOUT_SUCCESS_URL=
# STRIPE_CHECKOUT_CANCEL_URL=
# STRIPE_PORTAL_RETURN_URL=
# STRIPE_WEBHOOK_SECRET=

# --- Team collab scaffold (invite drafts only; billing stays off) ---
# DISCOVERY_TEAM_COLLAB_SCAFFOLD=0

# --- Trial Intelligence (keep OFF in production until SME/product sign-off) ---
# VITE_TRIAL_INTELLIGENCE=0
# TRIAL_INTELLIGENCE=0

# --- Playwright E2E (never commit credentials; skips ≠ passes — e2e/README.md) ---
# E2E_BASE_URL=http://127.0.0.1:4173
# E2E_USER_A_EMAIL=
# E2E_USER_A_PASSWORD=
# E2E_USER_B_EMAIL=
# E2E_USER_B_PASSWORD=
# E2E_USER_EMAIL=              # optional single-account fallback
# E2E_USER_PASSWORD=

# --- Legacy Lovable Cloud / Supabase (no longer used by runtime auth/curation) ---
# Keep only if you still need to export historical evidence from Lovable.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_PROJECT_ID=
# SUPABASE_SERVICE_ROLE_KEY=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_PROJECT_ID=
