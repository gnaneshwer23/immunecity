# Copy from Vercel Neon integration (prefer `vercel env pull .env.local`).
# Never commit real values. Rotate any DB password that was pasted into chat.

# Neon (Vercel integration injects these)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Managed Better Auth (Console → Project → Auth → Configuration)
# Same value for browser + server; JWKS can be derived as ${NEON_AUTH_BASE_URL}/.well-known/jwks.json
VITE_NEON_AUTH_URL=
NEON_AUTH_BASE_URL=
# Optional override (defaults to ${NEON_AUTH_BASE_URL}/.well-known/jwks.json)
# NEON_AUTH_JWKS_URL=

# Optional alias used by older Lovable migration tooling
# LOVABLE_DB_MIGRATION_URL=

# Ask AI: configure one server-only provider key; never use a VITE_ prefix.
# LOVABLE_API_KEY=
# OPENAI_API_KEY=

# --- Legacy Lovable Cloud / Supabase (no longer used by runtime auth/curation) ---
# Keep only if you still need to export historical evidence from Lovable.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_PROJECT_ID=
# SUPABASE_SERVICE_ROLE_KEY=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_PROJECT_ID=
